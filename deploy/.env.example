# Copy to deploy/.env and set real values. deploy/.env is git-ignored; only this example is committed.

# --- database ---------------------------------------------------------------------------------
POSTGRES_USER=mtgvault
POSTGRES_DB=mtgvault
# Required. Use a long random value, e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=

# --- public address and TLS -------------------------------------------------------------------
# `localhost` (development): the proxy issues a certificate from its own local CA.
# A real domain (production): a Let's Encrypt certificate is obtained and renewed automatically;
# set HTTP_PORT=80 and HTTPS_PORT=443 and make both reachable from the internet.
APP_HOST=localhost
HTTP_PORT=8080
HTTPS_PORT=8443
# HSTS lifetime in seconds. Keep it short until HTTPS works everywhere, then use 31536000 (one year).
HSTS_MAX_AGE=300

# --- API --------------------------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
