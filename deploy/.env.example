# Copy to deploy/.env and set real values. deploy/.env is git-ignored; only this example is committed.

# --- database ---------------------------------------------------------------------------------
POSTGRES_USER=mtgvault
POSTGRES_DB=mtgvault
# Required. Use a long random value, e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=

# --- public address and TLS -------------------------------------------------------------------
# `localhost` (development): the proxy issues a certificate from its own local CA.
# A real domain (production): a Let's Encrypt certificate is obtained and renewed automatically;
# set HTTP_PORT=80 and HTTPS_PORT=443 and make both reachable from the internet.
APP_HOST=localhost
HTTP_PORT=8080
HTTPS_PORT=8443
# HSTS lifetime in seconds. Keep it short until HTTPS works everywhere, then use 31536000 (one year).
HSTS_MAX_AGE=300

# --- API --------------------------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# --- identity provider (external OIDC provider, ADR-003) ----------------------------------------
# Issuer URL of your provider; the API reads its discovery document and signing keys from there.
# Must be https (http only for localhost). Required.
OIDC_ISSUER_URL=https://auth.example.org
# Client id registered at the provider for this environment (public client, PKCE).
OIDC_CLIENT_ID=mtgvault-local
# The audience your provider puts into access tokens for this API (the SPA requests it explicitly).
OIDC_AUDIENCE=mtgvault-api
# Browser origins allowed to call the API (comma-separated). Defaults to this stack's own origin.
# CORS_ORIGINS=https://localhost:8443
# Interactive API documentation under /api/v1/docs; keep false in production.
API_DOCS_ENABLED=false
