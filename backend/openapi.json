  "info": {
    "description": "REST API of MTG Card Vault. Every versioned route needs an OIDC bearer token. Every error is an RFC 9457 `application/problem+json` document carrying a `correlation_id`, also returned in the `X-Request-ID` header.",
    "summary": "Private, priced inventory of a Magic: The Gathering collection.",
    "title": "MTG Card Vault API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/catalog/cards": {
      "get": {
        "description": "Unique cards matching the text and filters; an empty list when nothing matches.",
        "operationId": "searchCards",
        "parameters": [
          {
            "description": "Words of the card name",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Words of the card name",
              "title": "Q"
            }
          },
          {
            "description": "Set code, e.g. lea",
            "in": "query",
            "name": "set",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 6,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Set code, e.g. lea",
              "title": "Set"
            }
          },
          {
            "description": "Letters W U B R G or C",
            "in": "query",
            "name": "colors",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 11,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Letters W U B R G or C",
              "title": "Colors"
            }
          },
          {
            "description": "Part of the type line",
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 40,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Part of the type line",
              "title": "Type"
            }
          },
          {
            "in": "query",
            "name": "rarity",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "common",
                    "uncommon",
                    "rare",
                    "mythic"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Rarity"
            }
          },
          {
            "description": "1-based page of the source list",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "description": "1-based page of the source list",
              "maximum": 100,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing or invalid token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not allowed"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validation failed"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unexpected error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The identity provider is unreachable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Search cards by name and filters",
        "tags": [
          "catalog"
        ]
      }
    },
